# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# MySQL connection string.
#
# TiDB Cloud Serverless (free forever) gives you something like:
#   mysql://<user>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/portfolio?sslaccept=strict
#
# The `?sslaccept=strict` on the end is REQUIRED for TiDB — it refuses
# unencrypted connections. Any other MySQL 8 host works too.
DATABASE_URL="mysql://user:password@host:4000/portfolio?sslaccept=strict"

# Secret used to sign the admin session cookie.
# Generate one with:  npx auth secret     (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Alias kept for familiarity — AUTH_SECRET takes priority if both are set.
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# Canonical site URL. Locally this is http://localhost:3000.
# On Vercel this is inferred automatically, so you can leave it unset there.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Seed credentials — only read by `npm run db:seed`, never at runtime.
# Change the password from the admin panel after your first sign-in.
# ---------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeMe123!"

# ---------------------------------------------------------------------------
# Cloudinary (optional) — only needed for the unsigned upload widget.
# Images work fine without this: paste any public image URL into the admin.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
